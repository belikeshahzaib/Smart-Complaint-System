<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %> | Smart Complaint System</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

<nav class="navbar">
  <div class="nav-inner">
    <a href="/" class="nav-brand">
      <span class="brand-icon">⚙</span>
      <span class="brand-text">ComplainT<span class="brand-accent">rack</span></span>
    </a>
    <ul class="nav-links">
      <% if (session && session.userId) { %>
        <% if (session.role === 'student') { %>
          <li><a href="/student/dashboard" class="nav-link">Dashboard</a></li>
          <li><a href="/student/submit" class="nav-link">New Complaint</a></li>
          <li><a href="/student/my-complaints" class="nav-link">My Complaints</a></li>
        <% } else { %>
          <li><a href="/technician/dashboard" class="nav-link">Dashboard</a></li>
          <li><a href="/technician/resolved" class="nav-link">Resolved</a></li>
        <% } %>
        <li><a href="/about" class="nav-link">About</a></li>
        <li class="nav-user">
          <span class="user-badge <%= session.role %>"><%= session.role %></span>
          <span class="user-name"><%= session.fullName %></span>
        </li>
        <li><a href="/logout" class="btn-nav-logout">Logout</a></li>
      <% } else { %>
        <li><a href="/" class="nav-link">Home</a></li>
        <li><a href="/about" class="nav-link">About</a></li>
        <li><a href="/login" class="nav-link">Login</a></li>
        <li><a href="/signup" class="btn-nav-signup">Sign Up</a></li>
      <% } %>
    </ul>
  </div>
</nav>
