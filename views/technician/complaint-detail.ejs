<%- include('../partials/header') %>

<main class="detail-page">
  <a href="/technician/dashboard" class="back-link">← Back to Dashboard</a>

  <% if (error) { %><div class="alert alert-error"><span>⚠</span> <%= error %></div><% } %>
  <% if (success) { %><div class="alert alert-success"><span>✓</span> <%= success %></div><% } %>

  <div class="detail-grid">
    <!-- Main -->
    <div class="detail-main">
      <div class="detail-card">
        <div class="detail-top">
          <span class="cat-pill cat-<%= complaint.category %>"><%= complaint.category %></span>
          <span class="status-pill status-<%= complaint.status %>"><%= complaint.status.replace('_',' ') %></span>
          <span class="priority-pill pri-<%= complaint.priority %>"><%= complaint.priority %></span>
        </div>
        <h1><%= complaint.title %></h1>
        <p class="detail-location">📍 <%= complaint.location %></p>
        <div class="detail-section">
          <h3>Problem Description</h3>
          <p><%= complaint.description %></p>
        </div>
        <div class="detail-section reporter-info">
          <h3>Reported By</h3>
          <p>👤 <strong><%= complaint.student_name %></strong> (<%= complaint.student_email %>)
          <% if (complaint.department) { %> — <%= complaint.department %><% } %></p>
        </div>
      </div>

      <!-- Update Form -->
      <% if (!['resolved','closed'].includes(complaint.status) || complaint.assigned_to == session.userId) { %>
      <div class="detail-card update-form-card">
        <h3>Update Complaint Status</h3>
        <form method="POST" action="/technician/update/<%= complaint.id %>" class="update-form">

          <div class="form-row">
            <div class="form-group">
              <label for="status">New Status *</label>
              <select id="status" name="status" required onchange="handleStatusChange(this.value)">
                <option value="assigned" <%= complaint.status === 'assigned' ? 'selected' : '' %>>🟡 Assigned (Taking ownership)</option>
                <option value="in_progress" <%= complaint.status === 'in_progress' ? 'selected' : '' %>>🔵 In Progress (Working on it)</option>
                <option value="resolved" <%= complaint.status === 'resolved' ? 'selected' : '' %>>✅ Resolved (Issue fixed!)</option>
                <option value="closed" <%= complaint.status === 'closed' ? 'selected' : '' %>>🔒 Closed</option>
              </select>
            </div>

            <div class="form-group" id="eta-group">
              <label for="estimated_fix_time">Estimated Fix Time</label>
              <input type="datetime-local" id="estimated_fix_time" name="estimated_fix_time"
                value="<%= complaint.estimated_fix_time ? new Date(complaint.estimated_fix_time).toISOString().slice(0,16) : '' %>" />
              <span class="field-hint">Tell the student when to expect the fix</span>
            </div>
          </div>

          <div class="form-group">
            <label for="admin_notes">Technician Notes</label>
            <textarea id="admin_notes" name="admin_notes" rows="4" 
              placeholder="Describe what you found, what you did, any parts needed, follow-up required..."><%= complaint.admin_notes || '' %></textarea>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn-primary">Update Complaint →</button>
          </div>
        </form>
      </div>
      <% } %>

      <!-- Activity Log -->
      <% if (logs.length > 0) { %>
      <div class="detail-card">
        <h3>Activity Log</h3>
        <div class="activity-log">
          <% logs.forEach(log => { %>
          <div class="log-entry">
            <div class="log-dot"></div>
            <div class="log-content">
              <strong><%= log.full_name || 'System' %></strong>
              <span class="log-action"><%= log.action.replace('_', ' ') %></span>
              <% if (log.details) { %><p class="log-detail"><%= log.details %></p><% } %>
              <span class="log-time"><%= new Date(log.created_at).toLocaleString('en-PK') %></span>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>
    </div>

    <!-- Sidebar -->
    <div class="detail-side">
      <div class="detail-card side-info">
        <h3>Complaint Info</h3>
        <div class="info-row"><span>ID</span><strong>#<%= complaint.id %></strong></div>
        <div class="info-row"><span>Submitted</span><strong><%= new Date(complaint.created_at).toLocaleDateString('en-PK') %></strong></div>
        <div class="info-row"><span>Priority</span><strong><span class="priority-pill pri-<%= complaint.priority %>"><%= complaint.priority %></span></strong></div>
        <% if (complaint.estimated_fix_time) { %>
          <div class="info-row eta-row">
            <span>ETA</span>
            <strong>⏱ <%= new Date(complaint.estimated_fix_time).toLocaleString('en-PK') %></strong>
          </div>
        <% } %>
        <% if (complaint.actual_fix_time) { %>
          <div class="info-row resolved-row">
            <span>Fixed On</span>
            <strong>✅ <%= new Date(complaint.actual_fix_time).toLocaleString('en-PK') %></strong>
          </div>
        <% } %>
      </div>

      <div class="detail-card side-timeline">
        <h3>Status Progress</h3>
        <div class="timeline">
          <% const stages = ['open','assigned','in_progress','resolved']; %>
          <% const currentIdx = stages.indexOf(complaint.status); %>
          <% stages.forEach((stage, i) => { %>
          <div class="tl-step <%= i <= currentIdx ? 'tl-done' : '' %>">
            <div class="tl-dot"></div>
            <span><%= stage.replace('_',' ').replace(/\b\w/g, c => c.toUpperCase()) %></span>
          </div>
          <% }) %>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
function handleStatusChange(val) {
  const eta = document.getElementById('eta-group');
  if (val === 'resolved' || val === 'closed') {
    eta.style.opacity = '0.4';
  } else {
    eta.style.opacity = '1';
  }
}
</script>

<%- include('../partials/footer') %>
