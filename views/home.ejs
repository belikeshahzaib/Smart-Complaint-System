<%- include('partials/header') %>

<main class="home-page">
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg-grid"></div>
    <div class="hero-content">
      <div class="hero-badge">FAST NUCES — Internal System</div>
      <h1 class="hero-title">
        Smart <span class="text-accent">Complaint</span><br/>
        Management System
      </h1>
      <p class="hero-sub">
        Report service issues digitally. Track resolutions transparently. 
        Connecting students with technicians — fast and efficiently.
      </p>
      <div class="hero-cta">
        <a href="/signup" class="btn-primary">Get Started</a>
        <a href="/login" class="btn-outline">Login</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="float-card fc1">
        <span class="fc-icon">💡</span>
        <span>Electricity Issue</span>
        <span class="fc-status open">Open</span>
      </div>
      <div class="float-card fc2">
        <span class="fc-icon">🔧</span>
        <span>Plumbing Fix</span>
        <span class="fc-status resolved">Resolved</span>
      </div>
      <div class="float-card fc3">
        <span class="fc-icon">📶</span>
        <span>Internet Down</span>
        <span class="fc-status progress">In Progress</span>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="how-it-works">
    <h2 class="section-title">How It Works</h2>
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-num">01</div>
        <h3>Create Account</h3>
        <p>Sign up as a student or technician using your university email address.</p>
      </div>
      <div class="step-card">
        <div class="step-num">02</div>
        <h3>Submit Complaint</h3>
        <p>Students describe the issue, select category, location, and priority level.</p>
      </div>
      <div class="step-card">
        <div class="step-num">03</div>
        <h3>Technician Assigned</h3>
        <p>Technicians pick up open complaints and provide estimated resolution time.</p>
      </div>
      <div class="step-card">
        <div class="step-num">04</div>
        <h3>Track & Resolve</h3>
        <p>Status updates in real-time. Rate the service once your issue is fixed.</p>
      </div>
    </div>
  </section>

  <!-- CATEGORIES -->
  <section class="categories">
    <h2 class="section-title">Service Categories</h2>
    <div class="cat-grid">
      <div class="cat-card"><span>⚡</span><p>Electricity</p></div>
      <div class="cat-card"><span>🚿</span><p>Plumbing</p></div>
      <div class="cat-card"><span>📶</span><p>Internet</p></div>
      <div class="cat-card"><span>❄️</span><p>HVAC / AC</p></div>
      <div class="cat-card"><span>🪑</span><p>Furniture</p></div>
      <div class="cat-card"><span>🔒</span><p>Security</p></div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
